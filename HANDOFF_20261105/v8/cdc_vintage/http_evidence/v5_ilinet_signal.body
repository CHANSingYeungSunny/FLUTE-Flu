        <main>
          
            <h1 class="no_toc" id="fluview-ilinet-outpatient-illness">
  
  
    <a href="#fluview-ilinet-outpatient-illness" class="anchor-heading" aria-labelledby="fluview-ilinet-outpatient-illness"><svg viewBox="0 0 16 16" aria-hidden="true"><use xlink:href="#svg-link"></use></svg></a> FluView ILINet Outpatient Illness
  
  
</h1>
    

<div class="table-wrapper"><table>
  <thead>
